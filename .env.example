# Environment Configuration Template
# Copy this file to .env.local for local development
# or .env.production for production deployment

# Server Configuration
LMS_SERVER_MODE=debug  # debug, release
LMS_SERVER_PORT=8080
LMS_SERVER_HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/database_name?sslmode=disable
LMS_DATABASE_HOST=localhost
LMS_DATABASE_PORT=5432
LMS_DATABASE_NAME=lms_dev
LMS_DATABASE_USER=lms_user
LMS_DATABASE_PASSWORD=your_secure_password_here
LMS_DATABASE_SSL_MODE=disable  # disable for local, require for production
LMS_DATABASE_MAX_CONNECTIONS=25
LMS_DATABASE_MAX_IDLE_CONNECTIONS=5
LMS_DATABASE_CONNECTION_MAX_LIFETIME=5m

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
LMS_REDIS_HOST=localhost
LMS_REDIS_PORT=6379
LMS_REDIS_PASSWORD=
LMS_REDIS_DB=0
LMS_REDIS_MAX_RETRIES=3
LMS_REDIS_POOL_SIZE=10

# JWT Configuration
LMS_JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
LMS_JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-at-least-32-characters-long
LMS_JWT_EXPIRATION=15m  # Access token expiration
LMS_JWT_REFRESH_EXPIRATION=168h  # Refresh token expiration (7 days)
LMS_JWT_ISSUER=library-management-system
LMS_JWT_AUDIENCE=lms-users

# Email Configuration
LMS_EMAIL_SMTP_HOST=smtp.gmail.com
LMS_EMAIL_SMTP_PORT=587
LMS_EMAIL_SMTP_USERNAME=your-email@gmail.com
LMS_EMAIL_SMTP_PASSWORD=your-app-password
LMS_EMAIL_FROM_EMAIL=noreply@yourlibrary.com
LMS_EMAIL_FROM_NAME=Library Management System
LMS_EMAIL_USE_TLS=true
LMS_EMAIL_USE_SSL=false
LMS_EMAIL_TIMEOUT=30s

# Rate Limiting Configuration
LMS_RATE_LIMIT_ENABLED=true
LMS_RATE_LIMIT_AUTH_REQUESTS=5  # per minute
LMS_RATE_LIMIT_API_REQUESTS=100  # per minute per user
LMS_RATE_LIMIT_SEARCH_REQUESTS=30  # per minute

# File Upload Configuration
LMS_UPLOAD_MAX_SIZE=5MB
LMS_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
LMS_UPLOAD_PATH=./uploads
LMS_UPLOAD_URL_PREFIX=/uploads

# Logging Configuration
LMS_LOG_LEVEL=info  # debug, info, warn, error
LMS_LOG_FORMAT=json  # json, text
LMS_LOG_FILE_ENABLED=true
LMS_LOG_FILE_PATH=./logs/lms.log
LMS_LOG_MAX_SIZE=100MB
LMS_LOG_MAX_BACKUPS=3
LMS_LOG_MAX_AGE=28  # days
LMS_LOG_COMPRESS=true

# Security Configuration
LMS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
LMS_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
LMS_CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
LMS_CORS_ALLOW_CREDENTIALS=true
LMS_SECURITY_HEADERS_ENABLED=true
LMS_CSRF_PROTECTION_ENABLED=false  # Enable for web forms

# Cache Configuration
LMS_CACHE_ENABLED=true
LMS_CACHE_DEFAULT_TTL=15m
LMS_CACHE_BOOK_CATALOG_TTL=30m
LMS_CACHE_STUDENT_PROFILE_TTL=15m
LMS_CACHE_POPULAR_BOOKS_TTL=1h
LMS_CACHE_SEARCH_RESULTS_TTL=5m

# Monitoring and Health Checks
LMS_HEALTH_CHECK_ENABLED=true
LMS_HEALTH_CHECK_PATH=/health
LMS_METRICS_ENABLED=true
LMS_METRICS_PATH=/metrics
LMS_PROFILING_ENABLED=false  # Enable for debugging

# Business Logic Configuration
LMS_BORROWING_PERIOD_DAYS=14
LMS_MAX_BOOKS_PER_STUDENT=5
LMS_RENEWAL_LIMIT=2
LMS_FINE_PER_DAY=0.50
LMS_RESERVATION_EXPIRY_HOURS=24
LMS_MAX_RESERVATIONS_PER_STUDENT=5

# Backup Configuration
LMS_BACKUP_ENABLED=true
LMS_BACKUP_INTERVAL=24h
LMS_BACKUP_RETENTION_DAYS=30
LMS_BACKUP_PATH=./backups
LMS_BACKUP_COMPRESS=true

# Development/Debug Configuration
LMS_DEBUG_ENABLED=false
LMS_DEBUG_LOG_SQL=false
LMS_DEBUG_LOG_REQUESTS=false
LMS_PROFILER_ENABLED=false
LMS_SWAGGER_ENABLED=false  # Enable for API documentation

# External Services (if applicable)
LMS_SMS_PROVIDER=
LMS_SMS_API_KEY=
LMS_SMS_FROM_NUMBER=

# Timezone
LMS_TIMEZONE=UTC

# Feature Flags
LMS_FEATURE_RESERVATIONS_ENABLED=true
LMS_FEATURE_EMAIL_NOTIFICATIONS_ENABLED=true
LMS_FEATURE_SMS_NOTIFICATIONS_ENABLED=false
LMS_FEATURE_AUDIT_LOGGING_ENABLED=true
LMS_FEATURE_SOFT_DELETE_ENABLED=true
LMS_FEATURE_CACHE_ENABLED=true
LMS_FEATURE_RATE_LIMITING_ENABLED=true